# Makefile.leddemo — dev-board LED demo, built separately from the player.
#
#   make -f Makefile.leddemo          build
#   make -f Makefile.leddemo flash    write it with the WCH-LinkE
#   make -f Makefile.leddemo clean
#
# Deliberately its own makefile: the demo shares board.h and the pin map with
# the product but none of its sources, and mixing them in one target would mean
# a stray edit to the demo could end up in the thing that ships.
#
# It compiles src/demo/led_wave_demo.c only — no audio.c, no spiflash.c, so it
# builds and runs while those are still skeletons.

TARGET      := src/demo/led_wave_demo
CH32V003FUN ?= ch32v003fun/ch32fun
MINICHLINK  ?= ch32v003fun/minichlink

TARGET_MCU  := CH32V003

# Set before the include: ch32v003fun.mk appends to CFLAGS, so anything put here
# survives. -Isrc finds board.h, -Isrc/demo finds demo_board.h and the generated
# chant_led.h.
CFLAGS += -Isrc -Isrc/demo

include $(CH32V003FUN)/ch32fun.mk

.PHONY: flash clean-all

flash: $(TARGET).bin
	$(MINICHLINK)/minichlink -w $< flash -b

clean-all: clean
	rm -f $(TARGET).bin $(TARGET).elf $(TARGET).map
